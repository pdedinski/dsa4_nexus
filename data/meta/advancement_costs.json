  "spell_columns": {
    "description": "Spell activation uses SKT row Akt./0 (BRW p.198). SP step costs use talent_columns (same SKT, including A*). Effective column = base complexity + foreign-representation (+2) and House Spell (−1) shifts, clamped A*–H. Max SP is calculated from the spell's three test attributes (own representation: highest +3; foreign: lowest). Per-spell max_starting_sp in spells.json is legacy/unused.",
    "skt_activation_row_Akt_per_0": {
      "A_STAR": 5,
      "A": 5,
      "B": 10,
      "C": 15,
      "D": 20,
      "E": 25,
      "F": 40,
      "G": 50,
      "H": 100
    },
    "max_activations_at_creation": 7
  },
  "generation_point_conversion": {
    "description": "During character creation, Talent Generation Points (TGP) may be converted to Spell Generation Points (SGP).",
    "formula": "TGP_to_SGP: up to (CL + IN) * 10 TGP may be converted; no conversion in reverse",
    "base_TGP_formula": "(CL + IN) * 20",
    "base_SGP_formula": "(CL + IN) * 5"
  },
  "advancement_summary": {
    "description": "Quick reference: which column is typical for which talent type",
    "column_A": ["Languages", "Scripts", "Read/Write", "Cultural Lore", "Local Knowledge"],
    "column_B": ["Social talents (most)", "Lore talents (most)", "Easy physical talents"],
    "column_C": ["Physical talents (harder)", "Combat talents (basic)", "Many artisan talents"],
    "column_D": ["Physical talents (hard)", "Combat talents (intermediate)"],
    "column_E": ["Combat talents (advanced): Two-Handed Swords, Lancing"],
    "column_F": ["Rare specialty talents", "Some supernatural aptitudes"],
    "column_G": ["Supernatural aptitudes (advanced)", "Very rare abilities"],
    "column_H": ["Legendary abilities only"]
  },
