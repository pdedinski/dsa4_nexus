# Copy to .env and fill in values.

# Canonical public URL of this app (no trailing slash). Used for OAuth redirect_uri.
# Must match the address bar origin when you sign in: http vs https, hostname, port.
# Google Cloud Console → OAuth client → Authorized redirect URIs must include:
#   {AUTH_URL}/api/auth/callback/google
# Examples:
#   AUTH_URL=http://localhost:3000
#   AUTH_URL=http://127.0.0.1:3000
#   AUTH_URL=https://your-production-domain.com
AUTH_URL=http://localhost:3000

# openssl rand -base64 32
AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma-separated Google emails that get is_superuser + is_allowed on first login.
# Without this, new users still sign in but are sent to /pending until an admin allows them.
# SUPERUSER_EMAILS=you@example.com

# Database (see lib/db/databaseUrl.ts and lib/db/POSTGRES.md).
# If DBeaver works locally but Next.js gets "pg_hba.conf" / 28000: run `npm run dev` on the SAME
# machine as DBeaver, or use an SSH tunnel (DB_HOST=127.0.0.1, DB_PORT=local forward port).
# Optional: DATABASE_URL or POSTGRES_URL instead of DB_*.
# DB_HOST=
# DB_NAME=
# DB_PASSWORD=
# Same PostgreSQL role as DBeaver (pg_hba is per-user; "postgres" often is not allowed remotely).
# DB_USER=metalfai_tde
# DB_PORT=5432
# DB_SSL=true — only if PostgreSQL has ssl=on AND pg_hba uses hostssl for you; if db:test says
# "server does not support SSL", leave DB_SSL unset and remove sslmode= from DATABASE_URL.
# DB_SSL=true

# Cloudinary (image uploads for My Images). Get credentials from https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional upload folder prefix (default: DSA)
# CLOUDINARY_FOLDER=DSA
