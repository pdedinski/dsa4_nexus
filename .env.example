# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorized redirect URI exactly (e.g. http://localhost:3000/auth/google/callback)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Random string for express-session cookie signing (use a long random value in production)
SESSION_SECRET=

# Optional; defaults to 3000
# PORT=3000
